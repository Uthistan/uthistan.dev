# Copy to `.env.local` for development, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.
# These are read only in the server-side route handler (src/app/api/start-project/route.ts)
# and are never exposed to the browser — do not prefix any of them with NEXT_PUBLIC_.

# Required. Resend API key used to deliver the client declaration email.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Inbox that receives the declaration + PDF attachment.
# Defaults to uthistanravi@gmail.com when unset.
DECLARATION_TO_EMAIL=uthistanravi@gmail.com

# Optional. Sender shown on the email.
# Defaults to "Uthistan <onboarding@resend.dev>", Resend's shared sender, which
# works without a verified domain but can only deliver to the Resend account
# owner's address. Once you verify a domain, switch this to e.g.
# "Uthistan <declarations@uthistan.dev>".
DECLARATION_FROM_EMAIL=Uthistan <onboarding@resend.dev>
